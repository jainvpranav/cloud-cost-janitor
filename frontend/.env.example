# Copy this file to `.env` in the same folder, fill in the value, then restart
# `npm start`. Create React App only exposes variables prefixed with REACT_APP_,
# and changes here require a restart.
#
# Base URL of the Cost Janitor API — the API Gateway stage URL from the
# CloudFormation stack outputs. No trailing slash. Keep the stage suffix if your
# stage is not "prod", e.g.
#
#   https://abc123.execute-api.us-east-1.amazonaws.com/prod
#
# How it is used:
#   * `npm start` (development) — src/setupProxy.js forwards /findings,
#     /approvals, /teardown and /config to this URL, so the browser stays
#     same-origin and no CORS preflight happens locally.
#   * `npm run build` (production) — the app calls this URL directly from the
#     browser, which is why the API returns CORS headers.
#
# If this is empty, development requests hit the dev server and fail with
# "Cannot GET /findings", and production requests go nowhere.
REACT_APP_API_URL=
